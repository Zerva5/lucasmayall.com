{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Resume",
	"type": "object",
	"required": ["name", "contact", "sections"],
	"additionalProperties": false,
	"properties": {
		"name": { "type": "string" },
		"contact": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"required": ["label"],
				"additionalProperties": false,
				"properties": {
					"label": { "type": "string" },
					"href": { "type": "string" }
				}
			}
		},
		"sections": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"required": ["id", "heading"],
				"additionalProperties": false,
				"properties": {
					"id": { "type": "string" },
					"heading": { "type": "string" },
					"entries": {
						"type": "array",
						"items": {
							"type": "object",
							"required": ["role", "start", "organisation", "location"],
							"additionalProperties": false,
							"properties": {
								"role": { "type": "string" },
								"start": {
									"type": "string",
									"description": "Start date, e.g. 'October 2023'."
								},
								"end": {
									"type": ["string", "null"],
									"description": "End date, e.g. 'June 2023'. null means current."
								},
								"organisation": { "type": "string" },
								"location": { "type": "string" },
								"bullets": {
									"type": "array",
									"items": { "type": "string" }
								}
							}
						}
					},
					"groups": {
						"type": "array",
						"items": {
							"type": "object",
							"required": ["label", "items"],
							"additionalProperties": false,
							"properties": {
								"label": { "type": "string" },
								"items": {
									"type": "array",
									"items": { "type": "string" }
								}
							}
						}
					}
				}
			}
		}
	}
}
