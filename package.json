{
	"name": "lucasmayall.com",
	"private": true,
	"version": "1.0.0",
	"description": "Personal site for Lucas Mayall — resume, photos and about.",
	"scripts": {
		"dev": "vite dev",
		"build": "npm run resume:pdf -- --if-available && vite build",
		"preview": "vite preview",
		"resume:pdf": "node scripts/generate-resume-pdf.mjs",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run check:resume && npm run format:check",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:resume": "node scripts/check-resume-freshness.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.46.4",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.5.2",
		"sass": "^1.93.2",
		"svelte": "^5.39.11",
		"svelte-check": "^4.3.3",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3"
	},
	"type": "module"
}
